{
  "name": "OSIsoft PI datasource with the PI Web API simulator",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/go:1": { "version": "1.26" },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 4 },
  "postCreateCommand": ".devcontainer/setup.sh",
  "postStartCommand": ".devcontainer/start.sh",
  "forwardPorts": [3000, 8080],
  "portsAttributes": {
    "3000": { "label": "Grafana", "onAutoForward": "openBrowser" },
    "8080": { "label": "PI Web API simulator (piuser / pipass)", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["golang.go", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
